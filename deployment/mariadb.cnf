[mysqld]
basedir=/www/server/mysql
datadir=/var/lib/ticketflow-db
socket=/run/ticketflow-db/mysql.sock
pid-file=/run/ticketflow-db/mysql.pid
port=3317
bind-address=127.0.0.1
skip-name-resolve
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
innodb-buffer-pool-size=128M
max-connections=80
