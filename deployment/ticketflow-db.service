[Unit]
Description=TicketFlow isolated MariaDB
After=network.target
[Service]
Type=simple
User=ticketflow-db
Group=ticketflow-db
RuntimeDirectory=ticketflow-db
ExecStart=/www/server/mysql/bin/mariadbd --defaults-file=/etc/ticketflow/mariadb.cnf
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
TimeoutStopSec=120
[Install]
WantedBy=multi-user.target
