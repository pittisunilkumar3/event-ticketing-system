PORT=5001
HOST=127.0.0.1
# Behind a reverse proxy on the same server, set TRUST_PROXY=loopback.
TRUST_PROXY=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ticketing_db
JWT_SECRET=replace-with-a-long-random-secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this key backed up; changing it makes saved SMTP passwords unreadable.
SETTINGS_ENCRYPTION_KEY=

# SaaS: use the frontend origin. Leave BASE_DOMAIN empty for /o/organizer sites locally.
PUBLIC_SITE_URL=http://localhost:5173
BASE_DOMAIN=
# Set these in your environment, then run npm run platform-admin. No default platform password.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# Razorpay package purchases are one-time INR Orders, not recurring subscriptions.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set true for an isolated local copy of production data.
DISABLE_BACKGROUND_WORKERS=false
